# .env.staging.example — variables de la pile STAGING (docker-compose.staging.yml).
# Copier vers .env SUR LE SERVEUR DE STAGING (chmod 600) et remplacer chaque CHANGE_ME. Ne jamais versionner .env.
# Ne jamais réutiliser une valeur de production (clés, mots de passe, jetons, buckets, comptes de service).
#
# Variables APPARUES avec ce lot (absentes de l'ancien .env.example / de la production actuelle) :
#   PUBLIC_WEB_URL (obligatoire en prod)  FCM_CREDENTIALS_FILE / FCM_PROJECT_ID  ROUTING_OSRM_URL
#   PROXY_NETWORK  IMAGE_TAG  SENTRY_ENVIRONMENT  CHANNELS_USE_REDIS (sans effet en prod : Redis toujours utilisé)

# --- Environnement (le staging exécute les réglages de PRODUCTION : mêmes garde-fous) ---------------------------------
DJANGO_ENV=prod
DEBUG=False
SECRET_KEY=CHANGE_ME_longue_cle_aleatoire_50_caracteres_minimum
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_PII=0
IMAGE_TAG=staging
PROXY_NETWORK=proxy
# Traefik : nom du résolveur ACME (défaut « lets », celui de la production). Dokploy : TRAEFIK_CERTRESOLVER=letsencrypt et PROXY_NETWORK=dokploy-network.
# TRAEFIK_CERTRESOLVER=lets

# Reverse proxies de confiance devant l'application (Traefik = 1) : IP réelle du client pour la limitation de débit, Axes et la liste noire.
# TRUSTED_PROXY_COUNT=1

# --- Hôtes publics (DNS A/AAAA vers le serveur de staging AVANT le déploiement : Let's Encrypt) -------------------------
tratraweb_HOST=api-staging.example.com
FRONTEND_HOST=app-staging.example.com
MINIO_API_HOST=minio-staging.example.com
# Console MinIO et Adminer : NON exposés (Adminer : profil « tools », démarrage ponctuel lié à 127.0.0.1, voir docker-compose.staging.yml).

# --- Sécurité HTTP : l'hôte de l'API est OBLIGATOIRE dans ALLOWED_HOSTS (sonde de santé) ------------------------------
ALLOWED_HOSTS=api-staging.example.com,tratraweb-stg
CORS_ALLOWED_ORIGINS=https://app-staging.example.com
CSRF_TRUSTED_ORIGINS=https://app-staging.example.com,https://api-staging.example.com

# --- URL publiques encodées dans le web, les QR et l'app ----------------------------------------------------------------
# QR Tratra ID / mission / équipements = <PUBLIC_WEB_URL>/verify/<code> : DOIT être l'URL HTTPS du frontend staging.
PUBLIC_WEB_URL=https://app-staging.example.com
NEXT_PUBLIC_API_BASE=https://api-staging.example.com/handy
NEXT_PUBLIC_SITE_URL=https://app-staging.example.com
NEXT_PUBLIC_PAYMENT_METHODS=cash
NEXT_PUBLIC_ESCROW_ENABLED=false
NEXT_PUBLIC_MEDIA_ORIGINS=

# --- PostgreSQL / PostGIS : base STAGING dédiée (volume tratra-staging_postgres_data) -----------------------------------
DB_NAME=tratra_staging
DB_USER=tratra_staging
DB_PASSWORD=CHANGE_ME_mot_de_passe_base_staging
DB_HOST=tratradb
DB_PORT=5432

# --- Redis (broker Celery + couche de canaux WebSocket) ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0
CHANNELS_USE_REDIS=1

# --- Stockage objet : MinIO staging (jamais le MinIO de production) ----------------------------------------------------
MINIO_ENABLED=True
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_mot_de_passe
AWS_ACCESS_KEY_ID=CHANGE_ME_identique_MINIO_ROOT_USER_ou_cle_dediee
AWS_SECRET_ACCESS_KEY=CHANGE_ME_identique_MINIO_ROOT_PASSWORD_ou_secret_dedie
AWS_STORAGE_BUCKET_NAME=tratra-staging-media
KYC_STORAGE_BUCKET_NAME=tratra-staging-kyc-private
AWS_S3_ENDPOINT_URL=https://minio-staging.example.com
AWS_S3_CUSTOM_DOMAIN=minio-staging.example.com
AWS_S3_VERIFY=True
MEDIA_PUBLIC_HOSTS=minio-staging.example.com
KYC_MAX_UPLOAD_BYTES=10485760
# Parcours « Vérifier mon identité » : âge minimal pour proposer des services ; lecture automatique locale (Tesseract) des photos de pièce.
# KYC_MIN_AGE=18
# KYC_FLOW_OCR=True
KYC_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
KYC_SIGNED_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_TTL_SECONDS=604800
# AWS_S3_REGION_NAME=us-east-1

# --- SMS (codes OTP) : prod.py REFUSE de démarrer sans fournisseur réel -------------------------------------------------
# L'OTP n'est JAMAIS contourné. SMS_BACKEND accepte UN fournisseur (twilio, orange, africastalking) ou une LISTE ORDONNÉE
# (ex. twilio,orange) : si le premier échoue, le suivant envoie le même SMS (relève automatique). Tous les fournisseurs listés
# doivent être configurés. Staging : Africa's Talking en bac à sable (AT_SANDBOX=true, AT_USERNAME=sandbox) ou Twilio avec des
# identifiants valides (un compte d'essai n'envoie qu'aux numéros vérifiés). Voir docs/sms-otp.md.
SMS_BACKEND=CHANGE_ME_twilio_orange_ou_africastalking
SMS_DEFAULT_COUNTRY_CODE=225
# Pays présélectionné pour la saisie du téléphone ; en-tête de pays du proxy (ex. CF-IPCountry) si disponible.
# PHONE_DEFAULT_REGION=CI
# PHONE_IP_COUNTRY_HEADER=CF-IPCountry
# Push : afficher le texte des messages sur l'écran verrouillé (désactivé par défaut).
# PUSH_MESSAGE_PREVIEW=False
# « Se souvenir de moi » : durée de la session cochée (jours) et décochée (heures) ; cookie HttpOnly du site (chemin, domaine
# commun au site et à l'API si besoin, ex. .tratra.net).
# JWT_REMEMBER_DAYS=30
# JWT_SESSION_HOURS=12
# JWT_REFRESH_COOKIE_PATH=/handy/auth/
# JWT_REFRESH_COOKIE_DOMAIN=
SMS_TIMEOUT=10
# Secondes pendant lesquelles un fournisseur en panne est mis de côté (les envois suivants passent directement au suivant). 0 = jamais.
SMS_FAILOVER_COOLDOWN=60
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Orange (portail developer.orange.com → votre application → API SMS) : identifiant + secret de l'application, OU l'en-tête
# « Authorization header » fourni par le portail. ORANGE_SMS_SENDER = numéro d'expéditeur du pays (Côte d'Ivoire : 2250000).
# ORANGE_SMS_SENDER_NAME : nom d'expéditeur (11 caractères max), UNIQUEMENT après validation par Orange. ORANGE_SMS_RESOURCE_TYPE :
# SMS_OCB2 pour l'offre « Orange seulement ».
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_AUTHORIZATION_HEADER=
ORANGE_SMS_SENDER=2250000
ORANGE_SMS_SENDER_NAME=
ORANGE_SMS_RESOURCE_TYPE=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true
# --- Anti-fraude SMS et inscriptions (docs/anti-fraude-sms.md) -------------------------------------------------------------
# Interrupteurs (false = aucun SMS de ce type) ; destinations autorisées ; quotas atomiques (Redis, 0 = sans limite).
# SMS_ENABLED=true
# SMS_OTP_SIGNUP_ENABLED=true
# SMS_RECOVERY_ENABLED=true
# SMS_ALERTS_ENABLED=true
# SMS_ALLOWED_COUNTRY_CODES=225
# SMS_GLOBAL_HOURLY_LIMIT=30
# SMS_GLOBAL_DAILY_LIMIT=150
# SMS_PER_NUMBER_HOURLY_LIMIT=3
# SMS_PER_NUMBER_DAILY_LIMIT=6
# SMS_PER_IP_HOURLY_LIMIT=5
# SMS_PER_IP_DAILY_LIMIT=15
# SMS_PER_USER_DAILY_LIMIT=8
# SMS_ALERT_RATIO=0.8
# SIGNUP_PER_IP_HOURLY_LIMIT=5
# SIGNUP_PER_IP_DAILY_LIMIT=20
# SIGNUP_PER_DEVICE_DAILY_LIMIT=3
# SIGNUP_GLOBAL_HOURLY_LIMIT=60
# SIGNUP_SAME_NAME_DAILY_LIMIT=3
# SIGNUP_PHONE_BLOCK_HOURLY_LIMIT=3
# SIGNUP_PHONE_RANGE_DAILY_LIMIT=5
# Interrupteur des inscriptions publiques (false = suspendues pendant une attaque).
# SIGNUP_ENABLED=true
# PHONE_CHANGES_DAILY_LIMIT=3
# THROTTLE_OTP=10/hour
# THROTTLE_OTP_VERIFY=30/hour
# Cloudflare Turnstile : clé secrète (la clé publique va dans NEXT_PUBLIC_TURNSTILE_SITE_KEY du site) ; mode web | all | off.
TURNSTILE_SECRET_KEY=
# TURNSTILE_MODE=web
# Mode web : anti-robot exigé aussi des clients ni site ni application (script sans identifiant d'installation).
# TURNSTILE_UNKNOWN_CLIENTS=true
# Site derrière le proxy Cloudflare (adresse du visiteur lue dans CF-Connecting-IP, seulement depuis une adresse Cloudflare).
# CLOUDFLARE_PROXY=false
# Comptes non vérifiés : actions sensibles refusées ; comptes créés avant UNVERIFIED_RESTRICTIONS_SINCE (AAAA-MM-JJ) exemptés.
# UNVERIFIED_RESTRICTIONS=true
# UNVERIFIED_RESTRICTIONS_SINCE=
# Cache partagé (obligatoire en production) : par défaut REDIS_URL sur la base n° 1.
# CACHE_URL=redis://redis:6379/1
# Image des notifications push (annonces) : HTTPS exigé (false seulement pour une recette locale en http).
# PUSH_IMAGE_REQUIRE_HTTPS=true

# --- E-mail ---------------------------------------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME_smtp
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=no-reply@app-staging.example.com
# Expéditeur des alertes serveur (par défaut DEFAULT_FROM_EMAIL) et destinataires des alertes de quota SMS et des erreurs 500.
# Si l'expéditeur est en @tratra.net, le fournisseur SMTP doit figurer dans l'enregistrement SPF et signer en DKIM (sinon DMARC rejette).
SERVER_EMAIL=
ADMINS=Equipe Tratra <alertes@example.com>

# --- Sécurité de l'administration ---------------------------------------------------------------------------------------
# Double authentification (TOTP) des comptes d'administration : OBLIGATOIRE (défaut en production). Ne désactiver que pour un test ponctuel.
BACKOFFICE_MFA_REQUIRED=1
# Passe-droit historique de l'ancienne API pour le personnel sans rôle : FERMÉ (défaut en production). Attribuer d'abord les rôles :
#   manage.py assign_legacy_staff_roles --assign ID=RÔLE --apply   puis   manage.py security_preflight --strict
LEGACY_STAFF_BYPASS=0
# Clé dédiée au chiffrement des secrets MFA (sinon SECRET_KEY) : la changer oblige chaque administrateur à ré-enrôler son appareil.
MFA_ENCRYPTION_KEY=
# MFA_ISSUER=Tratra
# BACKOFFICE_MFA_MAX_AGE=43200
# MFA_MAX_FAILURES=5
# MFA_LOCK_SECONDS=900
# THROTTLE_MFA=20/min

# --- Paiements : désactivés en staging (espèces seulement). Secrets distincts de la production -------------------------
STRIPE_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_OM_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_MTN_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_CARD_WEBHOOK_SECRET=CHANGE_ME_aleatoire

# Prestataires : chacun reste INDISPONIBLE (503 « prestataire indisponible », aucun faux paiement) tant que TOUS ses identifiants sont vides
# ou absents. À renseigner uniquement après ouverture d'un compte marchand chez le prestataire — procédure : docs/paiements.md.
# Contrôle (sans rien afficher de secret) :  docker compose exec api python manage.py payments_check --ping
# URLs publiques HTTPS : retour du client, annulation, base des notifications (…/handy/payments/webhook/<om|mtn|card>/).
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_NOTIFY_BASE_URL=
# PAYMENT_HTTP_TIMEOUT=10
# Orange Money Web Payment (bac à sable : OM_CURRENCY=OUV) — OM_API_BASE=https://api.orange.com
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
# OM_API_BASE=https://api.orange.com
# OM_COUNTRY=ci
# OM_CURRENCY=XOF
# MTN MoMo Collection (bac à sable : MTN_MOMO_CURRENCY=EUR, MTN_MOMO_TARGET_ENV=sandbox) — production : mtnivorycoast
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_CURRENCY=XOF
# Carte Stripe : clé secrète sk_test_… en essai (jamais sk_live_… en staging) ; STRIPE_WEBHOOK_SECRET (ci-dessus) = secret « whsec_… » du point de terminaison.
STRIPE_SECRET_KEY=
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_CURRENCY=xof

# --- Push mobile (Firebase Cloud Messaging, API HTTP v1) ----------------------------------------------------------------
# Compte de service Firebase déposé sur le serveur dans ./secrets/fcm-service-account.json (propriétaire uid 10001, 0400).
# Laisser VIDE tant que le fichier n'existe pas : aucun push, aucune erreur (la notification in-app reste fiable).
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_FILE=/run/tratra-secrets/fcm-service-account.json
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# --- Suivi en direct : itinéraire / ETA (OSRM auto-hébergé). Vide = estimation à vol d'oiseau, étiquetée « estimate » -----
ROUTING_OSRM_URL=

# --- Adresses : recherche / géocodage (nominatim | google | none = saisie manuelle seulement) ---
# Les requêtes de recherche sont envoyées au fournisseur choisi (jamais l'identité du compte) ; les résultats sont mis en cache.
GEO_PROVIDER=nominatim
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_GOOGLE_API_KEY=
GEO_COUNTRY=ci
GEO_MAX_CALLS_PER_MINUTE=30
# Transport : la distance routière exige ROUTING_OSRM_URL ; sans lui, le forfait de secours (Back-Office > Réglages > Transport) s'applique.
ROUTING_TIMEOUT=3

# --- Limites de débit (facultatif ; valeurs par défaut du code) --------------------------------------------------------
# THROTTLE_ANON=60/min
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=10/min
# THROTTLE_CATALOG=240/min
# THROTTLE_KYC_FLOW=30/min
# THROTTLE_RECOVERY=20/hour
# THROTTLE_VERIFY=60/min
# THROTTLE_WEBHOOK=120/min
# THROTTLE_PAYMENT_REFRESH=30/min

# --- Entrypoint (entrypoint.sh) ------------------------------------------------------------------------------------------
RUN_MIGRATIONS=1
COLLECTSTATIC=auto
# NE PAS activer CREATE_SUPERUSER : mot de passe par défaut faible. Créer le superutilisateur à la main (voir la procédure).
CREATE_SUPERUSER=0

# --- Évaluations mutuelles ---
# Jours pendant lesquels une note reste masquée à l'autre partie (0 = publication immédiate) ; durée pendant laquelle une mission terminée peut être évaluée.
# EVALUATION_REVEAL_DAYS=7
# EVALUATION_WINDOW_DAYS=30
# THROTTLE_GEO=30/min

# --- Adresses (complément de GEO_* ci-dessus) ---
# GEO_TIMEOUT=4
# GEO_CACHE_TTL=86400
# GEO_USER_AGENT=Tratra/1.0 (contact: support@tratra.net)

# --- Contrôle intelligent (IA facultative) : voir docs/ia-controle.md ---
# Les documents KYC ne quittent JAMAIS le serveur sans AI_KYC_EXTERNAL_ENABLED=true ET une base légale AI_KYC_LEGAL_BASIS.
# AI_PROVIDERS=deepseek,anthropic
# AI_DEEPSEEK_API_KEY=
# AI_DEEPSEEK_URL=https://api.deepseek.com
# AI_DEEPSEEK_MODEL=deepseek-chat
# AI_ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_TIMEOUT=30
# AI_KYC_EXTERNAL_ENABLED=false
# AI_KYC_LEGAL_BASIS=
# KYC_FINGERPRINT_PEPPER=

# --- Tratra AI (assistant du Back-Office, rédaction assistée des messages) : voir docs/assistant-ia.md ---
# Mêmes clés que ci-dessus (exclusivement côté serveur). Sans clé : « IA non configurée ». Lecture seule, aucune action automatique.
# AI_ASSISTANT_ENABLED=true
# AI_ASSISTANT_PER_HOUR=30
# AI_ASSISTANT_PER_DAY=150
# AI_ASSISTANT_DAILY_TOKENS=150000
# AI_ASSISTANT_MAX_TOKENS=1024
# AI_ASSISTANT_DEADLINE=90
# AI_ASSISTANT_RETENTION_DAYS=90
# AI_DRAFT_PER_HOUR=30

# --- Vérification faciale biométrique du KYC (OFF par défaut) : voir docs/kyc-biometrique.md ---
# Sans fournisseur réel (BIOMETRIC_PROVIDER=none) : dossier EN ATTENTE de revue humaine, jamais de validation automatique.
# Les captures sont chiffrées (clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") et ne sont jamais envoyées à DeepSeek ni à Anthropic.
# BIOMETRIC_ENABLED=false
# BIOMETRIC_PROVIDER=none
# BIOMETRIC_API_URL=
# BIOMETRIC_API_KEY=
# BIOMETRIC_TIMEOUT=20
# BIOMETRIC_ENCRYPTION_KEY=
# BIOMETRIC_LIVENESS_THRESHOLD=0.90
# BIOMETRIC_MATCH_THRESHOLD=0.80
# BIOMETRIC_SESSION_TTL_SECONDS=600
# BIOMETRIC_MAX_ATTEMPTS_PER_DAY=3
# BIOMETRIC_MAX_ATTEMPTS_PER_WEEK=6
# BIOMETRIC_RETENTION_DAYS=30
# BIOMETRIC_CONSENT_VERSION=2026-10
# KYC_BIOMETRIC_REQUIRED=false
# THROTTLE_BIOMETRIC=60/min


# --- Messagerie interne (valeurs par défaut) ---
# MESSAGE_MAX_CHARS=4000
# MESSAGE_MAX_IMAGE_BYTES=10485760
# MESSAGE_MAX_VIDEO_BYTES=26214400
# MESSAGE_MAX_VIDEO_SECONDS=60
# MESSAGE_MAX_FILE_BYTES=10485760
# MESSAGE_NEW_CONVERSATIONS_PER_DAY=20
# THROTTLE_MESSAGING=60/min
# URL publique de l'API : seulement si le stockage local (développement) renvoie des URLs de médias relatives
# API_PUBLIC_URL=

# --- Statuts éphémères (valeurs par défaut) ---
# STATUS_TTL_HOURS=24
# STATUS_TEXT_MAX=700
# STATUS_VIDEO_MAX_SECONDS=30
# STATUS_MAX_IMAGE_BYTES=10485760
# STATUS_MAX_VIDEO_BYTES=31457280
# STATUS_IMAGE_MAX_SIDE=1600
# STATUS_MAX_ACTIVE_PER_USER=30
# Compter aussi les consultations répétées d'un même statut (sinon : un lecteur = une vue)
# STATUS_REPEAT_VIEWS_ENABLED=false
# STATUS_VIEW_DEBOUNCE_SECONDS=30
# Conservation : média gardé N heures après l'expiration, ligne N jours
# STATUS_MEDIA_RETENTION_HOURS=24
# STATUS_ROW_RETENTION_DAYS=30
# THROTTLE_STATUSES=30/min

# --- Support ---
# Adresse affichée aux utilisateurs bloqués après trop de tentatives de connexion.
# SUPPORT_EMAIL=support@tratra.net
