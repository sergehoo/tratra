# .env.staging.example — variables de la pile STAGING (docker-compose.staging.yml).
# Copier vers .env SUR LE SERVEUR DE STAGING (chmod 600) et remplacer chaque CHANGE_ME. Ne jamais versionner .env.
# Ne jamais réutiliser une valeur de production (clés, mots de passe, jetons, buckets, comptes de service).
#
# Variables APPARUES avec ce lot (absentes de l'ancien .env.example / de la production actuelle) :
#   PUBLIC_WEB_URL (obligatoire en prod)  FCM_CREDENTIALS_FILE / FCM_PROJECT_ID  ROUTING_OSRM_URL
#   PROXY_NETWORK  IMAGE_TAG  SENTRY_ENVIRONMENT  CHANNELS_USE_REDIS (sans effet en prod : Redis toujours utilisé)

# --- Environnement (le staging exécute les réglages de PRODUCTION : mêmes garde-fous) ---------------------------------
DJANGO_ENV=prod
DEBUG=False
SECRET_KEY=CHANGE_ME_longue_cle_aleatoire_50_caracteres_minimum
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
IMAGE_TAG=staging
PROXY_NETWORK=proxy

# --- Hôtes publics (DNS A/AAAA vers le serveur de staging AVANT le déploiement : Let's Encrypt) -------------------------
tratraweb_HOST=api-staging.example.com
FRONTEND_HOST=app-staging.example.com
MINIO_API_HOST=minio-staging.example.com
MINIO_CONSOLE_HOST=minio-console-staging.example.com
ADMINER_HOST=adminer-staging.example.com
# Adminer (profil « tools », à la demande) : htpasswd (échapper « $ » en « $$ »). Vide = Adminer inaccessible (sûr).
BASIC_AUTH_USERS=

# --- Sécurité HTTP : l'hôte de l'API est OBLIGATOIRE dans ALLOWED_HOSTS (sonde de santé) ------------------------------
ALLOWED_HOSTS=api-staging.example.com,tratraweb-stg
CORS_ALLOWED_ORIGINS=https://app-staging.example.com
CSRF_TRUSTED_ORIGINS=https://app-staging.example.com,https://api-staging.example.com

# --- URL publiques encodées dans le web, les QR et l'app ----------------------------------------------------------------
# QR Tratra ID / mission / équipements = <PUBLIC_WEB_URL>/verify/<code> : DOIT être l'URL HTTPS du frontend staging.
PUBLIC_WEB_URL=https://app-staging.example.com
NEXT_PUBLIC_API_BASE=https://api-staging.example.com/handy
NEXT_PUBLIC_SITE_URL=https://app-staging.example.com
NEXT_PUBLIC_PAYMENT_METHODS=cash
NEXT_PUBLIC_ESCROW_ENABLED=false
NEXT_PUBLIC_MEDIA_ORIGINS=

# --- PostgreSQL / PostGIS : base STAGING dédiée (volume tratra-staging_postgres_data) -----------------------------------
DB_NAME=tratra_staging
DB_USER=tratra_staging
DB_PASSWORD=CHANGE_ME_mot_de_passe_base_staging
DB_HOST=tratradb
DB_PORT=5432

# --- Redis (broker Celery + couche de canaux WebSocket) ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0
CHANNELS_USE_REDIS=1

# --- Stockage objet : MinIO staging (jamais le MinIO de production) ----------------------------------------------------
MINIO_ENABLED=True
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_mot_de_passe
AWS_ACCESS_KEY_ID=CHANGE_ME_identique_MINIO_ROOT_USER_ou_cle_dediee
AWS_SECRET_ACCESS_KEY=CHANGE_ME_identique_MINIO_ROOT_PASSWORD_ou_secret_dedie
AWS_STORAGE_BUCKET_NAME=tratra-staging-media
KYC_STORAGE_BUCKET_NAME=tratra-staging-kyc-private
AWS_S3_ENDPOINT_URL=https://minio-staging.example.com
AWS_S3_CUSTOM_DOMAIN=minio-staging.example.com
AWS_S3_VERIFY=True
MEDIA_PUBLIC_HOSTS=minio-staging.example.com
KYC_MAX_UPLOAD_BYTES=10485760
KYC_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
KYC_SIGNED_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_TTL_SECONDS=604800

# --- SMS (codes OTP) : prod.py REFUSE de démarrer sans fournisseur réel -------------------------------------------------
# L'OTP n'est JAMAIS contourné. Staging : Africa's Talking en bac à sable (AT_SANDBOX=true, AT_USERNAME=sandbox) ou Twilio
# avec des identifiants valides (un compte d'essai n'envoie qu'aux numéros vérifiés). Voir docs/sms-otp.md.
SMS_BACKEND=CHANGE_ME_twilio_ou_africastalking
SMS_DEFAULT_COUNTRY_CODE=225
SMS_TIMEOUT=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# --- E-mail ---------------------------------------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME_smtp
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=no-reply@app-staging.example.com

# --- Paiements : désactivés en staging (espèces seulement). Secrets distincts de la production -------------------------
STRIPE_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_OM_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_MTN_WEBHOOK_SECRET=CHANGE_ME_aleatoire
PAYMENT_CARD_WEBHOOK_SECRET=CHANGE_ME_aleatoire

# --- Push mobile (Firebase Cloud Messaging, API HTTP v1) ----------------------------------------------------------------
# Compte de service Firebase déposé sur le serveur dans ./secrets/fcm-service-account.json (propriétaire uid 10001, 0400).
# Laisser VIDE tant que le fichier n'existe pas : aucun push, aucune erreur (la notification in-app reste fiable).
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_FILE=/run/tratra-secrets/fcm-service-account.json
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# --- Suivi en direct : itinéraire / ETA (OSRM auto-hébergé). Vide = estimation à vol d'oiseau, étiquetée « estimate » -----
ROUTING_OSRM_URL=
ROUTING_TIMEOUT=3

# --- Limites de débit (facultatif ; valeurs par défaut du code) --------------------------------------------------------
# THROTTLE_ANON=60/min
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=10/min
# THROTTLE_RECOVERY=20/hour
# THROTTLE_VERIFY=60/min
# THROTTLE_WEBHOOK=120/min

# --- Entrypoint (entrypoint.sh) ------------------------------------------------------------------------------------------
RUN_MIGRATIONS=1
COLLECTSTATIC=auto
# NE PAS activer CREATE_SUPERUSER : mot de passe par défaut faible. Créer le superutilisateur à la main (voir la procédure).
CREATE_SUPERUSER=0
