# Copy this file to .env and replace every placeholder before deployment.
# Never commit the populated .env file.

# Django
DJANGO_ENV=prod
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
tratraweb_HOST=api.example.com
FRONTEND_HOST=app.example.com
NEXT_PUBLIC_API_BASE=https://api.example.com/handy
# Enable om/mtn/card only after each live adapter and signed webhook are ready.
NEXT_PUBLIC_PAYMENT_METHODS=cash
# Frontend build-time variables (embedded by `next build`; rebuild after a change).
# Public site URL (canonical, sitemap, robots, Open Graph). Empty = https://${FRONTEND_HOST}.
NEXT_PUBLIC_SITE_URL=
# Extra comma-separated media origins for the CSP img-src. AWS_S3_ENDPOINT_URL
# (which signs the media URLs) is already added by docker-compose.
NEXT_PUBLIC_MEDIA_ORIGINS=
# Escrow wording on the site: enable only once an online payment with escrow is
# really operational (non-cash provider live + signed webhook).
NEXT_PUBLIC_ESCROW_ENABLED=false
ALLOWED_HOSTS=api.example.com,tratraweb
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
LOG_LEVEL=INFO

# PostgreSQL / PostGIS
DB_NAME=tratra
DB_USER=tratra
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=tratradb
DB_PORT=5432

# Redis / asynchronous work
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# Payment and monitoring secrets. Leave payment providers disabled until the
# corresponding provider credentials and webhook configuration are complete.
STRIPE_WEBHOOK_SECRET=replace-me
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
PAYMENT_OM_WEBHOOK_SECRET=replace-with-a-different-random-secret
PAYMENT_MTN_WEBHOOK_SECRET=replace-with-a-different-random-secret
PAYMENT_CARD_WEBHOOK_SECRET=replace-with-a-different-random-secret
SENTRY_DSN=
# Étiquette de l'environnement dans Sentry (défaut : production si DJANGO_ENV=prod). Staging : staging.
# SENTRY_ENVIRONMENT=staging

# Private object storage. Use a dedicated private bucket for KYC documents.
MINIO_ENABLED=True
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-with-a-strong-secret
AWS_STORAGE_BUCKET_NAME=tratra-media
KYC_STORAGE_BUCKET_NAME=tratra-kyc-private
# Also injected into the frontend image CSP (img-src) by docker-compose.
AWS_S3_ENDPOINT_URL=https://minio.example.com
AWS_S3_CUSTOM_DOMAIN=minio.example.com
AWS_S3_VERIFY=True
KYC_MAX_UPLOAD_BYTES=10485760
KYC_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
KYC_SIGNED_URL_TTL_SECONDS=300
# Signing TTL for public media (service images, artisan photos), distinct from
# the KYC TTL above: must outlive cached (ISR) pages. 604800 s = SigV4 maximum.
MEDIA_SIGNED_URL_TTL_SECONDS=604800
# Hosts allowed in Service.image_url (https only). Empty = host of AWS_S3_ENDPOINT_URL.
MEDIA_PUBLIC_HOSTS=

# Traefik endpoints
MINIO_API_HOST=minio.example.com
# Console MinIO et Adminer : NON exposés (aucun hôte public). Adminer : profil « tools », démarrage ponctuel lié à 127.0.0.1 (voir docker-compose.yml).

# --- SMS (codes OTP) : voir docs/sms-otp.md ---
# En production : "twilio", "orange" ou "africastalking", ou une LISTE ORDONNÉE pour la relève automatique (ex. "twilio,orange" :
# si Twilio échoue, Orange envoie le même SMS). prod.py refuse de démarrer sinon. En développement : vide ou "console"
# (aucun SMS réel : le code est journalisé et renvoyé par l'API en DEBUG uniquement).
SMS_BACKEND=
SMS_DEFAULT_COUNTRY_CODE=225
SMS_TIMEOUT=10
# Secondes pendant lesquelles un fournisseur en panne est mis de côté (les envois suivants passent directement au suivant). 0 = jamais.
SMS_FAILOVER_COOLDOWN=60
# Twilio : TWILIO_MESSAGING_SERVICE_SID OU TWILIO_FROM (alias TWILIO_PHONE_NUMBER)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Orange : identifiant + secret de l'application OU l'en-tête « Authorization header » du portail ; numéro d'expéditeur du pays
# (Côte d'Ivoire : 2250000) ; nom d'expéditeur seulement une fois validé par Orange ; SMS_OCB2 pour l'offre « Orange seulement ».
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_AUTHORIZATION_HEADER=
ORANGE_SMS_SENDER=2250000
ORANGE_SMS_SENDER_NAME=
ORANGE_SMS_RESOURCE_TYPE=
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
# Celery : sans REDIS_URL (développement local), les tâches s'exécutent aussitôt dans le processus.
# REDIS_URL=redis://redis:6379/0

# --- Tratra ID / suivi (QR de vérification) ---
# URL publique du site web : encodée dans les QR (https://<site>/verify/<code>). OBLIGATOIRE en production, en HTTPS
# (prod.py refuse de démarrer sinon). Développement : http://localhost:3000.
PUBLIC_WEB_URL=http://localhost:3000
# Développement : couche de canaux en mémoire par défaut ; mettre 1 pour utiliser Redis (REDIS_HOST) comme en production.
CHANNELS_USE_REDIS=0
# Itinéraire / ETA réels (OSRM auto-hébergé). Vide = estimation à vol d'oiseau, étiquetée comme telle.
ROUTING_OSRM_URL=

# --- Adresses : recherche / géocodage (nominatim | google | none = saisie manuelle seulement) ---
# Les requêtes de recherche sont envoyées au fournisseur choisi (jamais l'identité du compte) ; les résultats sont mis en cache.
GEO_PROVIDER=nominatim
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_GOOGLE_API_KEY=
GEO_COUNTRY=ci
GEO_MAX_CALLS_PER_MINUTE=30
# Transport : la distance routière exige ROUTING_OSRM_URL ; sans lui, le forfait de secours (Back-Office > Réglages > Transport) s'applique.

# --- Push mobile (Firebase Cloud Messaging, API HTTP v1) : voir handy/push.py ---
# Chemin du JSON de compte de service Firebase (ou son contenu dans FCM_CREDENTIALS_JSON). Vide = aucun push.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=
ROUTING_TIMEOUT=3

# --- Limites de débit (facultatif ; valeurs par défaut) ---
# Nombre de reverse proxies de confiance devant l'application (Traefik = 1). Sert à connaître l'IP réelle du client pour la limitation de débit,
# le verrouillage après échecs de connexion (Axes) et la liste noire. Mettre 0 si l'application est exposée SANS proxy (jamais derrière un
# proxy qui laisse passer l'en-tête X-Forwarded-For écrit par le client). Défaut : 1 en production, 0 en développement.
# TRUSTED_PROXY_COUNT=1
# THROTTLE_ANON=60/min
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=10/min
# THROTTLE_RECOVERY=20/hour
# THROTTLE_VERIFY=60/min
# THROTTLE_WEBHOOK=120/min
# AWS_S3_REGION_NAME=us-east-1

# --- Sécurité de l'administration (défauts de PRODUCTION : MFA exigée, passe-droit historique fermé) -----------------
# Première mise à jour d'un serveur existant : si le personnel n'a pas encore ses rôles / sa double authentification, les relâcher
# EXPLICITEMENT le temps de la transition (avertissements tratra.W001/W002 au démarrage), puis les remettre :
#   manage.py assign_legacy_staff_roles --assign ID=RÔLE --apply   →   chaque administrateur active sa MFA   →   security_preflight --strict --require-mfa
# BACKOFFICE_MFA_REQUIRED=1
# LEGACY_STAFF_BYPASS=0
# MFA_ENCRYPTION_KEY=

# --- Contrôle intelligent (KYC, fraude) : IA FACULTATIVE ; sans clé, les règles déterministes fonctionnent seules ---
# Ordre = priorité (repli automatique). DeepSeek lit le texte ; seul Anthropic lit les images.
AI_PROVIDERS=deepseek,anthropic
AI_DEEPSEEK_API_KEY=
AI_ANTHROPIC_API_KEY=
# Les documents KYC ne quittent JAMAIS le serveur tant que les DEUX lignes suivantes ne sont pas renseignées (activation explicite + base légale).
AI_KYC_EXTERNAL_ENABLED=false
AI_KYC_LEGAL_BASIS=
# Sel de l'empreinte des numéros de documents (défaut : SECRET_KEY). Ne jamais le changer sans migration des empreintes.
KYC_FINGERPRINT_PEPPER=

# --- Vérification faciale biométrique du KYC (OFF par défaut) : voir docs/kyc-biometrique.md ---
# Sans fournisseur réel (BIOMETRIC_PROVIDER=none) : dossier EN ATTENTE de revue humaine, jamais de validation automatique.
# Les captures sont chiffrées (clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") et ne sont jamais envoyées à DeepSeek ni à Anthropic.
# BIOMETRIC_ENABLED=false
# BIOMETRIC_PROVIDER=none
# BIOMETRIC_API_URL=
# BIOMETRIC_API_KEY=
# BIOMETRIC_TIMEOUT=20
# BIOMETRIC_ENCRYPTION_KEY=
# BIOMETRIC_LIVENESS_THRESHOLD=0.90
# BIOMETRIC_MATCH_THRESHOLD=0.80
# BIOMETRIC_SESSION_TTL_SECONDS=600
# BIOMETRIC_MAX_ATTEMPTS_PER_DAY=3
# BIOMETRIC_MAX_ATTEMPTS_PER_WEEK=6
# BIOMETRIC_RETENTION_DAYS=30
# BIOMETRIC_CONSENT_VERSION=2026-10
# KYC_BIOMETRIC_REQUIRED=false
# THROTTLE_BIOMETRIC=60/min

