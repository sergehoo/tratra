# Copy this file to .env and replace every placeholder before deployment.
# Never commit the populated .env file.

# Django
DJANGO_ENV=prod
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
tratraweb_HOST=api.example.com
FRONTEND_HOST=app.example.com
NEXT_PUBLIC_API_BASE=https://api.example.com/handy
# Enable om/mtn/card only after each live adapter and signed webhook are ready.
NEXT_PUBLIC_PAYMENT_METHODS=cash
# Frontend build-time variables (embedded by `next build`; rebuild after a change).
# Public site URL (canonical, sitemap, robots, Open Graph). Empty = https://${FRONTEND_HOST}.
NEXT_PUBLIC_SITE_URL=
# Extra comma-separated media origins for the CSP img-src. AWS_S3_ENDPOINT_URL
# (which signs the media URLs) is already added by docker-compose.
NEXT_PUBLIC_MEDIA_ORIGINS=
# Escrow wording on the site: enable only once an online payment with escrow is
# really operational (non-cash provider live + signed webhook).
NEXT_PUBLIC_ESCROW_ENABLED=false
ALLOWED_HOSTS=api.example.com,tratraweb
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
LOG_LEVEL=INFO

# PostgreSQL / PostGIS
DB_NAME=tratra
DB_USER=tratra
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=tratradb
DB_PORT=5432

# Redis / asynchronous work
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# Payment and monitoring secrets. Leave payment providers disabled until the
# corresponding provider credentials and webhook configuration are complete.
STRIPE_WEBHOOK_SECRET=replace-me
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
PAYMENT_OM_WEBHOOK_SECRET=replace-with-a-different-random-secret
PAYMENT_MTN_WEBHOOK_SECRET=replace-with-a-different-random-secret
PAYMENT_CARD_WEBHOOK_SECRET=replace-with-a-different-random-secret
SENTRY_DSN=

# Private object storage. Use a dedicated private bucket for KYC documents.
MINIO_ENABLED=True
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-with-a-strong-secret
AWS_STORAGE_BUCKET_NAME=tratra-media
KYC_STORAGE_BUCKET_NAME=tratra-kyc-private
# Also injected into the frontend image CSP (img-src) by docker-compose.
AWS_S3_ENDPOINT_URL=https://minio.example.com
AWS_S3_CUSTOM_DOMAIN=minio.example.com
AWS_S3_VERIFY=True
KYC_MAX_UPLOAD_BYTES=10485760
KYC_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
KYC_SIGNED_URL_TTL_SECONDS=300
# Signing TTL for public media (service images, artisan photos), distinct from
# the KYC TTL above: must outlive cached (ISR) pages. 604800 s = SigV4 maximum.
MEDIA_SIGNED_URL_TTL_SECONDS=604800
# Hosts allowed in Service.image_url (https only). Empty = host of AWS_S3_ENDPOINT_URL.
MEDIA_PUBLIC_HOSTS=

# Traefik endpoints
MINIO_API_HOST=minio.example.com
MINIO_CONSOLE_HOST=minio-console.example.com
ADMINER_HOST=adminer.example.com
ADMINER_AUTH_SUFFIX=,adminer-auth@docker
BASIC_AUTH_USERS=replace-with-htpasswd-output

# --- SMS (codes OTP) : voir docs/sms-otp.md ---
# En production : "twilio" ou "africastalking" (prod.py refuse de démarrer sinon). En développement :
# vide ou "console" (aucun SMS réel : le code est journalisé et renvoyé par l'API en DEBUG uniquement).
SMS_BACKEND=
SMS_DEFAULT_COUNTRY_CODE=225
SMS_TIMEOUT=10
# Twilio : TWILIO_MESSAGING_SERVICE_SID OU TWILIO_FROM (alias TWILIO_PHONE_NUMBER)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
# Celery : sans REDIS_URL (développement local), les tâches s'exécutent aussitôt dans le processus.
# REDIS_URL=redis://redis:6379/0

# --- Tratra ID / suivi (QR de vérification) ---
# URL publique du site web : encodée dans les QR (https://<site>/verify/<code>). Obligatoire en production.
PUBLIC_WEB_URL=http://localhost:3000

