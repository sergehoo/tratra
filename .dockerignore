# Secrets & données locales — ne JAMAIS embarquer dans l'image
.env
.env.*
*.env
db.sqlite3
db.sqlite3-journal

# Environnements & dépendances
venv/
.venv/
env/
node_modules/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Artefacts générés au build/runtime
staticfiles/
media/

# Outillage / IDE / OS
.git/
.gitignore
.idea/
.vscode/
*.iml
.DS_Store

# Flutter / Dart (résidus, hors périmètre backend)
.dart_tool/
.flutter-plugins-dependencies
.metadata

# Docs / divers
*.md

# Staging : secrets montés à l'exécution et sauvegardes — jamais dans l'image
secrets/
backups/
scripts/staging/

# Identifiants Firebase / Apple / signature : JAMAIS versionnés (fournis au build ou déposés sur le serveur dans ./secrets)
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
*service-account*.json
fcm-*.json
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore
