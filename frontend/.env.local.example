# Base de l'API Django (préfixe /handy). Copier en .env.local et adapter.
NEXT_PUBLIC_API_BASE=http://localhost:8000/handy
# Cash is the safe default until an online provider and signed webhook are live.
NEXT_PUBLIC_PAYMENT_METHODS=cash
# Mentions de « paiement sous séquestre » sur le site. À n'activer (true) que
# lorsqu'un paiement en ligne avec séquestre est réellement opérationnel.
NEXT_PUBLIC_ESCROW_ENABLED=false
# URL publique du site (SEO : URLs canoniques, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://tratra.net
# Origines additionnelles servant les médias (S3/MinIO), séparées par des virgules.
# L'origine de NEXT_PUBLIC_API_BASE est déjà autorisée.
NEXT_PUBLIC_MEDIA_ORIGINS=
# (Optionnel) Base API joignable depuis le serveur Next (ex. réseau Docker
# interne http://web:8000/handy). Par défaut : NEXT_PUBLIC_API_BASE.
API_INTERNAL_BASE=
