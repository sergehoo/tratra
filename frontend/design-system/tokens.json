{
  "name": "Tratra Design System",
  "version": "1.0.0",
  "reference": "Landing React (frontend/src/app/page.tsx) — référence visuelle officielle",

  "color": {
    "brand": {
      "primary": "#2e8b57",
      "primaryDark": "#1f6a41",
      "primaryDeep": "#185736",
      "primarySoft": "#e8f6ee",
      "accent": "#F6C90E",
      "accentBright": "#ffd42e",
      "accentDark": "#d4aa00",
      "accentSoft": "#FFF8D6",
      "night": "#0b1210",
      "nightSoft": "#15201b"
    },
    "neutral": {
      "ink": "#0f172a",
      "inkSoft": "#475569",
      "ash": "#6b7280",
      "fog": "#94a3b8",
      "line": "#e2e8f0",
      "lineSoft": "#f1f5f9",
      "canvas": "#f8fafc",
      "surface": "#ffffff"
    },
    "feedback": {
      "success": "#059669",
      "successSoft": "#ecfdf5",
      "successInk": "#047857",
      "warning": "#d97706",
      "warningSoft": "#fffbeb",
      "warningInk": "#92400e",
      "danger": "#dc2626",
      "dangerSoft": "#fef2f2",
      "dangerInk": "#b91c1c",
      "info": "#0284c7",
      "infoSoft": "#f0f9ff",
      "infoInk": "#075985"
    }
  },

  "gradient": {
    "brand": ["#2e8b57", "#1f6a41"],
    "night": ["#0b1210", "#15201b"],
    "accent": ["#F6C90E", "#ffd42e"],
    "wash": ["#e8f6ee", "#ffffff"]
  },

  "font": {
    "display": { "family": "Montserrat", "weights": [600, 700, 800], "fallback": "system-ui, sans-serif" },
    "body": { "family": "Poppins", "weights": [400, 500, 600, 700], "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "brand": { "family": "Bonskin", "weights": [400], "fallback": "cursive", "usage": "Nom « Tratra » uniquement (script de marque) — licence commerciale requise, voir BONSKIN-LICENCE.md" }
  },

  "type": {
    "displayXl": { "font": "display", "size": 64, "sizeMobile": 36, "line": 1.05, "weight": 800, "tracking": -0.02 },
    "displayLg": { "font": "display", "size": 44, "sizeMobile": 30, "line": 1.1, "weight": 800, "tracking": -0.015 },
    "h1": { "font": "display", "size": 32, "sizeMobile": 26, "line": 1.15, "weight": 800, "tracking": -0.01 },
    "h2": { "font": "display", "size": 24, "sizeMobile": 21, "line": 1.2, "weight": 700, "tracking": -0.005 },
    "h3": { "font": "display", "size": 19, "sizeMobile": 18, "line": 1.25, "weight": 700, "tracking": 0 },
    "title": { "font": "body", "size": 16, "sizeMobile": 16, "line": 1.4, "weight": 600, "tracking": 0 },
    "bodyLg": { "font": "body", "size": 18, "sizeMobile": 16, "line": 1.6, "weight": 400, "tracking": 0 },
    "body": { "font": "body", "size": 15, "sizeMobile": 15, "line": 1.6, "weight": 400, "tracking": 0 },
    "bodySm": { "font": "body", "size": 13, "sizeMobile": 13, "line": 1.5, "weight": 400, "tracking": 0 },
    "caption": { "font": "body", "size": 12, "sizeMobile": 12, "line": 1.4, "weight": 500, "tracking": 0 },
    "eyebrow": { "font": "body", "size": 11, "sizeMobile": 11, "line": 1.2, "weight": 700, "tracking": 0.16 },
    "button": { "font": "body", "size": 15, "sizeMobile": 15, "line": 1.2, "weight": 600, "tracking": 0 }
  },

  "space": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "28": 112
  },

  "radius": {
    "sm": 8,
    "control": 12,
    "panel": 16,
    "card": 24,
    "sheet": 28,
    "pill": 9999
  },

  "shadow": {
    "hair": { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#0f172a", "alpha": 0.06 },
    "soft": { "x": 0, "y": 8, "blur": 24, "spread": 0, "color": "#0f172a", "alpha": 0.08 },
    "strong": { "x": 0, "y": 16, "blur": 48, "spread": 0, "color": "#0f172a", "alpha": 0.12 },
    "glow": { "x": 0, "y": 12, "blur": 40, "spread": 0, "color": "#2e8b57", "alpha": 0.35 },
    "glowAccent": { "x": 0, "y": 12, "blur": 32, "spread": -8, "color": "#F6C90E", "alpha": 0.55 }
  },

  "motion": {
    "duration": { "fast": 150, "base": 220, "slow": 420, "hero": 900 },
    "easing": {
      "emphasized": [0.22, 1, 0.36, 1],
      "standard": [0.4, 0, 0.2, 1]
    }
  },

  "layout": {
    "containerMax": 1280,
    "gutterMobile": 16,
    "gutterDesktop": 24,
    "touchTarget": 44,
    "controlHeight": 48,
    "sidebarWidth": 256,
    "topbarHeight": 64,
    "bottomNavHeight": 64,
    "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "windowClass": { "compact": 600, "medium": 840 }
  },

  "zIndex": { "header": 50, "overlay": 60, "modal": 70, "toast": 80 }
}
